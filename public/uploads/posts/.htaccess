# Uploaded files are only ever pictures or downloads. Never run anything from here.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
<FilesMatch "(?i)\.(php[0-9]?|phtml|phar|pl|py|cgi|sh|asp|aspx|jsp|exe|htaccess)$">
    Require all denied
</FilesMatch>
Options -ExecCGI -Indexes
RemoveHandler .php .phtml .phar
RemoveType .php .phtml .phar
